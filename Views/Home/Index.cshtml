            <div class="col">
                <div class="stat-card bg-green" data-status="Permanent Action">
                    <span class="count">0</span>
                    <small>Permanent Action</small>
                </div>
            </div>

            <div class="col">
                <div class="stat-card bg-gray" data-status="Closed">
                    <span class="count">0</span>
                    <small>Closed</small>
                </div>
            </div>

            <div class="col">
                <div class="stat-card bg-blue" data-status="ALL">
                    <span class="count">0</span>
