</div>

<div class="modal fade" id="viewPdf" tabindex="-1">
    <div class="modal-dialog modal-xxl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="fw-bold">Excel as PDF</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" style="height:80vh">
                <iframe id="pdfFrame" style="width:100%;height:100%;" frameborder="0"></iframe>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="downloadPdf" class="btn btn-primary" target="_blank">Download</a>
            </div>

        </div>
    </div>
</div>

<script>
    document.getElementById('downloadPdf').addEventListener('click', () => {
        const iframe = document.getElementById('pdfFrame');
        iframe.contentWindow.print();
    });
</script>

