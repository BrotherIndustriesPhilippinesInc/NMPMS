<script>
    document.getElementById('action_date').valueAsDate = new Date();
    document.getElementById('parts_action_date').valueAsDate = new Date();
    document.getElementById('implematation_Date').valueAsDate = new Date();

    const temp_pic = document.getElementById("s4_pic");
    const s7_pic = document.getElementById("s7_pic");

    if(!temp_pic.value){
         var userId = '@Context.Session.GetString("username")';
        temp_pic.value = userId;
    }

    if(!s7_pic.value){
         var userId = '@Context.Session.GetString("username")';
        s7_pic.value = userId;
    }

    
</script>
