<link href="~/css/home.css" rel="stylesheet" />

<style>
    .view-mode input,
    .view-mode textarea,
    .view-mode select {
        border: none !important;
        background: transparent !important;
        pointer-events: none;
        box-shadow: none !important;
        padding-left: 0;
    }

        .view-mode input[type="file"] {
            display: none;
        }

    .view-mode .photo-preview-placeholder {
        display: none;
    }

    .view-mode textarea {
        resize: none;
