<link href="~/css/home.css" rel="stylesheet" />

<style>
    /* ================= FULL REPORT STYLE ================= */
    .view-mode .modal-content {
        background: #fff;
        font-family: Arial, sans-serif;
    }

    /* HEADER */
    .view-mode .report-header h2 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .view-mode .report-header .subtitle {
        color: #666;
        font-size: 14px;
        margin-bottom: 15px;
    }

    /* META GRID */
    .view-mode .report-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px 30px;
        font-size: 14px;
    }

    /* REMOVE ALL CARD STYLE */
    .view-mode .card-glass {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }

    /* SECTION TITLE */
    .view-mode .section-title {
        font-size: 16px;
        font-weight: bold;
        border-bottom: 2px solid #000;
        padding-bottom: 4px;
        margin-top: 25px;
        margin-bottom: 10px;
    }

    /* FORM → REPORT ROW */
    .view-mode .form-group {
        display: grid;
        grid-template-columns: 180px 1fr;
        padding: 6px 0;
        border-bottom: 1px dotted #bbb;
    }

    /* LABEL */
    .view-mode label {
        font-weight: bold;
    }

    /* VALUE */
    .view-mode input,
    .view-mode textarea,
    .view-mode select {
        border: none !important;
        background: transparent !important;
        padding: 0 !important;
        margin: 0 !important;
        pointer-events: none;
    }

    /* REMOVE INPUT LOOK */
    .view-mode .form-control {
        border: none !important;
        background: transparent !important;
    }

    /* REMOVE PLACEHOLDER */
    .view-mode ::placeholder {
        color: transparent;
    }

    /* IMAGE STYLE */
    .view-mode img {
        max-width: 220px;
        border: 1px solid #ccc;
    }

    /* ATTACHMENT STYLE */
    .view-mode a {
        color: #0d6efd;
        text-decoration: underline;
    }

    /* HIDE EDIT ELEMENTS */
    .view-mode input[type="file"],
    .view-mode #photoDrop_analysis {
        display: none !important;
    }

    /* STEP BUTTONS OFF */
    .view-mode .step-nav {
        display: none;
    }
</style>
<div class="modal fade" id="pmlModal" tabindex="-1">
    <div class="modal-dialog modal-xxl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="fw-bold">Problem Management Log</h5>
                 
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="scrollArea">
                <div class="pms-details-wrap">
                    <div class="pms-details">
                        <div class="pms-title-line">
                            <strong><span id="pms_control_no"></span></strong>
                            <input type="hidden" id="control_no_input" name="control_no_input">
                        </div>

                        <div class="pms-row">
                            <div class="pms-label">Progress:</div>
                            @* <div class="pms-value" id="progress"></div> *@
                            <select class="form-select form-select-sm mb-2" id="progress" name="progress">
                                <option value="">Select Process</option>
                                <option value="Cause Investigation">Cause Investigation</option>
                                <option value="Temporary Action">Temporary Action</option>
                                <option value="Permanent Action">Permanent Action</option>
                                <option value="Cancel">Cancel</option>
                            </select>
                        </div>

                        <div class="pms-row">
                            <div class="pms-label">Person In-Charge:</div>
