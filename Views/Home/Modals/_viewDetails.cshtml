                        </div>
                    </div>
                </div>

                <div class="progress-wrap">
                    <div class="progress mb-2">
                        <div id="progressBar" class="progress-bar bg-primary"></div>
                    </div>
                    <div class="step-nav">
                        <button class="step-btn active" onclick="jump('s1',this)">1 Phenomenon</button>
                        <button class="step-btn" onclick="jump('s2',this)">2 Analysis</button>
                        <button class="step-btn" onclick="jump('s3',this)">3 Immediate</button>
                        <button class="step-btn" onclick="jump('s4',this)">4 Temporary</button>
