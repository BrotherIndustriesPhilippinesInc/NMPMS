                        <button class="step-btn" onclick="jump('s2',this)">2 Analysis</button>
                        <button class="step-btn" onclick="jump('s3',this)">3 Immediate</button>
                        <button class="step-btn" onclick="jump('s4',this)">4 Temporary</button>
                        <button class="step-btn" onclick="jump('s5',this)">5 Permanent</button>
                        <button class="step-btn" onclick="jump('s6',this)">6 Horizontal</button>
                        <button class="step-btn" onclick="jump('s7',this)">7 B-Action</button>
                    </div>
                </div>
                @* <form id="pms_details"> *@
